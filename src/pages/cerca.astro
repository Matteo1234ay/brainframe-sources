---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, getAllVideos } from '../lib/videos';
const docs = getAllVideos().map((video) => {
  const category = CATEGORIES.find((c) => c.id === video.category)!;
  return {
    slug: video.slug,
    title: video.title,
    category: category.label,
    text: [video.title, category.label, category.prompt, ...video.claims.flatMap((claim) => [claim.claim, claim.note ?? '', ...claim.sources.flatMap((source) => [source.title, source.author ?? ''])])].join(' ')
  };
});
const serialized = JSON.stringify(docs).replace(/</g, '\\u003c');
---
<BaseLayout title="Cerca — Brainframe">
  <main id="main-content" class="page-shell search-page">
    <header class="editorial-header"><p>Archivio Brainframe</p><h1>Cerca</h1></header>
    <section class="search-shell">
      <label class="sr-only" for="search">Cerca nelle fonti Brainframe</label>
      <input id="search" type="search" placeholder="Cerca video, claim o fonte…" data-search />
      <div class="results" data-results aria-live="polite"></div>
      <p class="empty" data-empty hidden>Nessun contenuto trovato.</p>
    </section>
    <script id="search-index" type="application/json" set:html={serialized}></script>
  </main>
  <script is:inline>
    const normalize = (value) => value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase('it').replace(/[^a-z0-9\s-]/g,' ').replace(/\s+/g,' ').trim();
    const input = document.querySelector('[data-search]');
    const results = document.querySelector('[data-results]');
    const empty = document.querySelector('[data-empty]');
    const data = JSON.parse(document.querySelector('#search-index')?.textContent || '[]');
    const base = document.documentElement.dataset.basePath || '';
    const render = () => {
      const query = input?.value || '';
      const terms = normalize(query).split(' ').filter(Boolean);
      results?.replaceChildren();
      if (!terms.length) { if (empty) empty.hidden = true; return; }
      const matches = data.filter((item) => { const hay = normalize(`${item.title} ${item.category} ${item.text}`); return terms.every((term) => hay.includes(term)); });
      if (empty) empty.hidden = matches.length > 0;
      for (const item of matches) {
        const link = document.createElement('a');
        link.href = `${base}/fonti/${item.slug}/`;
        const title = document.createElement('strong'); title.textContent = item.title;
        const category = document.createElement('span'); category.textContent = item.category;
        link.append(title, category); results?.append(link);
      }
    };
    input?.addEventListener('input', render);
  </script>
</BaseLayout>

<style>
  .search-page{padding-bottom:120px}.search-shell{max-width:860px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}input{width:100%;border:0;border-bottom:2px solid var(--bf-blue);border-radius:0;padding:16px 0;color:var(--bf-blue);background:transparent;font-family:var(--editorial);font-size:clamp(1.4rem,3vw,2rem);outline-offset:6px}.results{display:grid;margin-top:36px}.results a{display:grid;gap:4px;padding:20px 0;border-top:1px solid var(--bf-line);color:var(--bf-blue);text-decoration:none}.results strong{font-family:var(--editorial);font-size:1.25rem}.results span{color:var(--bf-muted);font-size:.9rem}.empty{color:var(--bf-muted);margin-top:32px}
</style>
